{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Waste Sorting and Recycling Reward System",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:smoke": "ts-node src/tests/smoke_test.ts",
    "test:security": "ts-node src/tests/security_test.ts",
    "test:confidence": "ts-node src/tests/confidence_threshold_test.ts",
    "test:duplicate": "ts-node src/tests/duplicate_image_test.ts",
    "test:wallet": "ts-node src/tests/wallet_smoke_test.ts",
    "test:chain": "ts-node src/tests/chain_authority_test.ts",
    "test:all": "ts-node src/tests/smoke_test.ts && ts-node src/tests/security_test.ts && ts-node src/tests/confidence_threshold_test.ts && ts-node src/tests/duplicate_image_test.ts && ts-node src/tests/wallet_smoke_test.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^9.14.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.12",
    "@types/nodemailer": "^7.0.10",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
