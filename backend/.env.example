# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/recycling_rewards

# JWT Configuration (REQUIRED - generate a strong secret for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google OAuth (for Google Sign-In)
# Get this from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================================================
# AI Inference Service (Python FastAPI)
# =============================================================================
AI_SERVICE_URL=http://127.0.0.1:8000

# =============================================================================
# Blockchain Configuration
# =============================================================================

# RPC URL (choose one based on environment)
# Local development (Ganache):
GANACHE_RPC_URL=http://127.0.0.1:8545
# Or use a dedicated RPC for testnet/mainnet:
# RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Chain ID (optional, auto-detected from RPC)
# 31337 = Hardhat/local, 11155111 = Sepolia, 137 = Polygon
CHAIN_ID=31337

# Contract Configuration
# After deploying RecyclingRewardsV2, update these values:
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
CONTRACT_ABI_PATH=../blockchain/artifacts/contracts/RecyclingRewardsV2.sol/RecyclingRewardsV2.json

# Service Account Private Key (NEVER commit real keys!)
# This account must have MINTER_ROLE on the contract
# For local dev (Hardhat account #0):
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Or use legacy name for Ganache:
# GANACHE_PRIVATE_KEY=your_ganache_private_key

# HD Wallet for Custodial Accounts (optional, for production)
# Generate with: npx ethers wallet random
# HD_WALLET_MNEMONIC=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=